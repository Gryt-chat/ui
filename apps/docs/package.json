    "@gryt/ui": "workspace:*",
    "@mdx-js/react": "^3.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "^5.1.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.10.1",
    "shiki": "^3.20.0"
  },
