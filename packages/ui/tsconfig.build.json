{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    // Drop the source mapping, exactly as ui-native's build config does.
    //
    // By build time @gryt/theme is built — bun orders the workspace by
    // dependency and this package depends on it — so resolving through the
    // exports map to dist is both correct and available. It is also what the
    // emitted declarations have to say, since a consumer has no ../theme/src.
    "paths": {}
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**"]
}
