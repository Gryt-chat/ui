{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // React Native's own JSX runtime, not the DOM one.
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "types": ["node", "vitest/globals"],
    "moduleResolution": "bundler",
    // Resolve @gryt/theme and @gryt/owl to their source, not to dist.
    //
    // The exports map points at ./dist/index.d.ts, which only exists after
    // @gryt/theme has been built. That made this package's typecheck depend on
    // a sibling's build artefact — it passed locally because dist happened to
    // be there and failed in CI, which typechecks without building.
    //
    // Only resolution is affected. The emitted declarations still say
    // "@gryt/theme", so consumers go through the exports map as normal.
    "baseUrl": ".",
    "paths": {
      "@gryt/theme": ["../theme/src/index.ts"],
      "@gryt/owl": ["../owl/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src"]
}
