{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // React Native's own JSX runtime, not the DOM one.
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "types": ["node", "vitest/globals"],
    "moduleResolution": "bundler",
    // Resolve @gryt/theme and @gryt/owl to their source, not to dist.
    //
    // The exports map points at ./dist/index.d.ts, which only exists after
    // @gryt/theme has been built. That made this package's typecheck depend on
    // a sibling's build artefact — it passed locally because dist happened to
    // be there and failed in CI, which typechecks without building.
    //
    // Only resolution is affected. The emitted declarations still say
    // "@gryt/theme", so consumers go through the exports map as normal.
    "baseUrl": ".",
    "paths": {
      "@gryt/theme": ["../theme/src/index.ts"],
      "@gryt/owl": ["../owl/src/index.ts"],
    // Phosphor icons come one file at a time from the package's `./src/icons/*`
    // subpath, because Metro does not tree-shake and the barrel pulls the whole
    // set into every app that installs this. That subpath serves untranspiled
    // `.tsx`, which TypeScript then compiles — and the library's own icon-base
    // passes a `className` to react-native-svg, which does not declare one.
    // `skipLibCheck` does not help: it skips `.d.ts`, and this is source.
    //
    // So TypeScript reads the package's generated declarations while Metro goes
    // on bundling the real `.tsx`. Both come from the same file. Copied from
    // packages/mobile, which hit this first.
    // Two entries because the install layout is not fixed: bun puts the package
    // under packages/ui-native/node_modules here and hoists it to the root in
    // CI, and a mapping that misses falls back to the .tsx and fails. Checked
    // both ways round.
    "phosphor-react-native/src/icons/*": [
      "./node_modules/phosphor-react-native/lib/typescript/icons/*",
      "../../node_modules/phosphor-react-native/lib/typescript/icons/*"
    ]
    },
    "noEmit": true
  },
  "include": ["src"]
}
