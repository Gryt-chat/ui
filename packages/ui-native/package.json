{
  "name": "@gryt/ui-native",
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "description": "Gryt's design system on React Native. Same tokens as @gryt/ui, a different renderer.",
  "homepage": "https://gryt.chat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gryt-chat/ui.git",
    "directory": "packages/ui-native"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/add-esm-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "peerDependencies": {
    "react": ">=18.3.0 || >=19.0.0",
    "react-native": ">=0.76.0",
    "react-native-reanimated": ">=4.0.0",
    "@gorhom/bottom-sheet": ">=5.2.0",
    "react-native-gesture-handler": ">=2.16.1"
  },
  "dependencies": {
    "@gryt/theme": "^0.3.0"
  },
  "devDependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-native": "^0.76.0",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-reanimated": "^4.5.1",
    "vitest": "^3.0.0"
  },
  "peerDependenciesMeta": {}
}
