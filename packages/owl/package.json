{
  "name": "@gryt/owl",
  "version": "0.2.0",
  "description": "Gryt's owl avatars. Give it a name, get an SVG. No renderer, no DOM, no dependencies.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://gryt.chat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gryt-chat/ui.git",
    "directory": "packages/owl"
  },
  "bugs": {
    "url": "https://github.com/Gryt-chat/ui/issues"
  },
  "keywords": [
    "gryt",
    "gryt-chat",
    "avatar",
    "avatars",
    "identicon",
    "svg",
    "deterministic"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "owl": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "accessories": "bun scripts/owl-accessory.ts --all",
    "accessories:check": "bun scripts/owl-accessory.ts --all --check",
    "accessories:base": "bun scripts/owl-accessory.ts --base",
    "dev": "vite build --watch",
    "build": "bun run accessories && vite build && vite build -c vite.config.cli.ts && bun scripts/fix-declarations.ts && bun scripts/check-dist-shape.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.16"
  }
}
