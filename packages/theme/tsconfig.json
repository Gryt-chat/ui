{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node", "vitest/globals"],
    // No DOM, deliberately. The point of this package is that a React Native
    // app can take the tokens, and the way that promise rots is somebody
    // reaching for `document` or `window` in a colour helper and nothing
    // stopping them. Dropping the DOM lib makes that a compile error here
    // rather than a runtime crash on a phone.
    "lib": ["ES2022"]
  },
  "include": ["src"]
}
