# Generated by apps/docs/scripts/generate-og.ts on every build. Committing 30
# PNGs would mean they silently go stale whenever a component description does.
apps/docs/public/og

# tsc emits next to the sources if a build config ever resolves a sibling
# package to its source instead of its dist. That happened once, in #56, and ten
# compiled copies of the theme were committed into packages/ui/src/theme before
# anyone noticed. Nothing in src is ever authored as .js or .d.ts.
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
